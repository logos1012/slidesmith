# Slidesmith v1.0.0 — .env.example
# 사용자: cp .env.example .env, 채우기
# 보안: .env는 .gitignore (절대 commit X). 노출 의심 시 즉시 키 회전.
#
# 키 분배 박제 (Vendor Encapsulation, Cycle 2 Fix F1):
#   - llm 컨테이너 → ANTHROPIC_API_KEY, GEMINI_API_KEY, CLAUDE_CLI_PATH
#   - storage 컨테이너 → AIRTABLE_PAT, AIRTABLE_BASE_ID, AWS_*
#   - render / web 컨테이너 → 외부 키 0 (web은 BFF로 위임)

# ─── External Services (필수) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...           # Anthropic Claude SDK fallback (llm)
AIRTABLE_PAT=patXXX...                 # Airtable Personal Access Token (storage)
AIRTABLE_BASE_ID=appXXX...             # Slidesmith base ID (storage)
AWS_ACCESS_KEY_ID=AKIA...              # AWS S3 IAM (storage)
AWS_SECRET_ACCESS_KEY=...              # AWS S3 secret (storage)
AWS_S3_BUCKET=slidesmith-carousel      # S3 버킷 이름 (storage)
AWS_S3_REGION=ap-northeast-2           # AWS 리전 (storage)

# ─── Optional (v1.0 후반 / v1.1+) ──────────────────────
GEMINI_API_KEY=AIza...                 # Google Gemini 이미지 생성 (llm, v1.0 후반 활성)
CLAUDE_CLI_PATH=/usr/local/bin/claude  # Claude CLI subprocess 경로 자동 감지 실패 시

# ─── Service URLs (Docker Compose 내부, 변경 X) ────────
# Compose 내부 DNS로 컨테이너 이름 직접 호출 — 변경하지 마세요.
LLM_SERVICE_URL=http://slidesmith-llm:3001
RENDER_SERVICE_URL=http://slidesmith-render:3002
STORAGE_SERVICE_URL=http://slidesmith-storage:3003
WEB_INTERNAL_URL=http://slidesmith-web:3000  # v1.0.1: BFF self-URL (render-temp PNGs)

# ─── Local Settings ────────────────────────────────────
LAN_EXPOSE=false                       # true 시 host 0.0.0.0:3000 (폰 핸드오프)
LOG_LEVEL=info                         # debug/info/warn/error (pino redact 자동)
SAGA_DB_PATH=/app/data/saga.db         # web sqlite saga state (영속 volume)
WEB_HOST_PORT=3000                     # 호스트 포트 충돌 시 변경 (예: 3100)

# ─── Feature Flags ─────────────────────────────────────
NEXT_PUBLIC_FEATURE_GEMINI=false       # v1.0 후반 ON (Gemini 이미지 생성)
NEXT_PUBLIC_FEATURE_DARK_MODE=true     # v1.0 manual toggle
NEXT_PUBLIC_FEATURE_AB_TEST=false      # v2

# ─── Branding (lib/branding.ts 단일 진입점) ────────────
NEXT_PUBLIC_GITHUB_REPO=https://github.com/logos1012/slidesmith
NEXT_PUBLIC_TAGLINE=한국어 인스타 카루셀, 1줄 → 5분 → 발행
