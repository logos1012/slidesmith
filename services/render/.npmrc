# pnpm 11 install hardening
#
# 1) auto-install-peers: install peerDependencies automatically (Cycle 2 will
#    add @types/* peer hops for puppeteer-extra-plugins).
# 2) strict-peer-dependencies=false: peer-dep mismatches warn instead of
#    failing the install (sharp's optionalDeps tree pulls a noisy chain).
# 3) only-built-dependencies: mirror of `pnpm.onlyBuiltDependencies` in
#    package.json. Pre-approves esbuild + sharp's native postinstalls so the
#    Docker `pnpm install --frozen-lockfile --ignore-scripts` flow doesn't
#    have to run them at image build time (sharp ships prebuilt platform
#    binaries via @img/sharp-* optional deps; esbuild does the same via
#    @esbuild/<platform>).
strict-peer-dependencies=false
auto-install-peers=true
only-built-dependencies[]=esbuild
only-built-dependencies[]=sharp
