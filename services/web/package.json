{
  "name": "slidesmith-web",
  "version": "1.0.0",
  "private": true,
  "description": "Slidesmith Web — UI + BFF + Saga (v1.0.0)",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
