    "react-hook-form": "^7.53.0",
    "zod": "^4.4.3",
    "@hookform/resolvers": "^3.9.0",
    "tailwind-merge": "^3.0.0",
    "clsx": "^2.1.1",
    "@base-ui-components/react": "^1.0.0-beta.0",
    "lucide-react": "^0.554.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "pino": "^9.5.0",
    "pino-roll": "^2.0.0",
    "p-limit": "^5.0.0",
    "opossum": "^8.4.0",
    "better-sqlite3": "^11.3.0",
    "uuid": "^10.0.0",
    "date-fns": "^4.1.0",
