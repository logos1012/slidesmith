{
  "name": "@slidesmith/llm",
  "version": "1.1.2",
  "description": "Slidesmith LLM service — Claude CLI subprocess + Anthropic SDK fallback + Gemini Python + SSE",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@hono/node-server": "^1.13.0",
    "eventsource-parser": "^1.1.2",
    "execa": "^9.5.0",
    "hono": "^4.6.0",
    "nanoid": "^5.0.0",
    "opossum": "^8.1.0",
    "p-limit": "^5.0.0",
    "pino": "^9.5.0",
    "pino-roll": "^3.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/opossum": "^8.1.8",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^10.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
